PROJECT_NAME="Умная диспетчеризация выездных бригад"
TEAM_NAME="Бубышки"
VERSION="1.0.0"
DEBUG=false
API_V1_PREFIX="/api"

# Server
HOST=0.0.0.0
PORT=8080

# Database
POSTGRES_SERVER=localhost
